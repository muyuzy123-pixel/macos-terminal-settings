"text.b5a89c580bcb1eb3" = "Delete explicit value";
"text.a6ae1f2955127cee" = "Delete the explicit value in the current user's domain, whether written by this app, another tool, or a user command. The effective Apple default or organization-enforced value will then apply.";
"text.ab2fe0f02f6e9f6f" = "Restore previous value";
