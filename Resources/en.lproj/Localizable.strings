"text.d3787d64b0cd0f61" = "System Settings";
"text.f092c276322b91a6" = "Desktop & Dock";
"text.3782b13d016b5d13" = "Size and magnification";
"text.c00967e20dafa7d3" = "System Settings provides size sliders. This control shows exact point values and accepts integer input.";
"text.e5b94e8ddd1c872f" = "Apple's device management definition specifies a range of 16–128. This does not guarantee visible effects when an ordinary app writes the preferences directly.";
"text.5b4f34b21071e49c" = "Wallpaper";
"text.9731ac14034290fd" = "Screen Saver";
"text.dd3524d2ea1a5db3" = "System Settings offers fixed times. This control provides exact seconds within a bounded range and a separate Never option.";
"text.2223f5690d8bb4e8" = "This uses current-host preferences. The device management definition establishes the unit and meaning of 0; actual behavior still requires separate verification.";
"text.6a1ffbfba58843aa" = "Uses the same Boolean capability as “Animate opening applications”.";
"text.6bf354dda742c858" = "Retained as a System Settings mirror in the existing catalog, not as a precedent for copying all System Settings controls.";
"text.af4c5a6efee0d2d9" = "More Gestures";
"text.d73bfe3fd3ce844b" = "This is a historically related entry for the legacy Launchpad gesture. Neither Tahoe's current graphical switch nor visible behavior proves that this key still controls it.";
"text.2c00c2623c44b685" = "Classified as a mirror only for its historical capability, not as an equivalent to Tahoe's current Applications gesture switch. Remains experimental and unstable.";
"text.1072d628fd0c7282" = "Minimize windows using";
"text.8c5b012f3753d3a3" = "System Settings provides standard effects; this control adds an unlisted historical enumeration value.";
"text.c5bdb4237d8737de" = "An extra enumeration value does not imply public Apple support.";
"text.aab845db616f599c" = "System Settings provides two sliders. This control shows integer system ticks and offers a bounded faster range.";
"text.fd3502f7b9b22f6a" = "Values remain system ticks; they are not converted to a fixed number of milliseconds.";
"text.35e0dcd33ecbf036" = "Set exact Dock icon sizes";
"text.9c8837ef04d17138" = "Set normal and magnified sizes independently in 1-point steps. Magnified size cannot be smaller than normal size.";
"text.e0a95f795b11f65f" = "Both sizes are applied together. When system magnification is off, the magnified size is stored for use when magnification is enabled.";
"text.aa12e8762c6ce1c4" = "Normal size";
"text.7d302fdd509e692c" = "Controls the normal Dock icon size. The app preset is 48 points, not the system default.";
"text.27841e1b6cdfb62f" = "pt";
"text.b845ded3da06cde0" = "Magnified size";
"text.ae76ba88cb3bfd61" = "Controls icon size when system magnification is enabled. The app preset is 64 points, not the system default.";
"text.776c2d3c6c1b7f9e" = "Magnified size cannot be smaller than normal size";
"text.8d3c57578be73dd" = "Dock restarts automatically; magnified size is visible only when system magnification is enabled";
"text.15a458a31fe657aa" = "Read-only checks on macOS 26.6.2 found the size values. Verification covers isolated write contracts and current-value reads only, not visible effects in the real Dock, intermediate-value feedback, or persistence. Magnification and size-lock flags are read-only.";
"text.387fefc6acf09adf" = "Adjust the hidden Dock's reveal delay";
"text.f2b65350b25613f3" = "Controls the wait after the pointer touches the screen edge. The safe preset reveals the Dock immediately; only applies when Dock auto-hide is enabled.";
"text.36b926bb9c9483ba" = "Dock restarts automatically";
"text.851d6a1f92ea22ec" = "Adjust the wait after the pointer touches the screen edge when auto-hide is enabled. The range is limited to checked nonnegative values.";
"text.8ce7f58ef2f78ca" = "Reveal delay";
"text.1a9aec6e725a8858" = "0 seconds reveals the Dock immediately. Larger values delay its appearance.";
"text.270c311b6c78fd13" = "s";
"text.ebca2b097e9749c0" = "Try a shorter Dock auto-hide animation";
"text.cde161f9a11abfbd" = "Writes the safe preset 0.18 to autohide-time-modifier. May change reveal and hide animations only when Dock auto-hide is enabled.";
"text.6ca19aa1d77e1855" = "Dock on macOS 26.6.1 still reads this key as a float, with a fallback of 1, and multiplies it by an internal constant. Online sources variously call it duration, multiplier, or speed. This bounded experimental slider offers 0.000–2.000 with a safe preset of 0.18. The value is not seconds; its exact relationship and direction relative to visible animation remain unverified.";
"text.9e24e564228f1601" = "Adjust the Dock animation coefficient within the reversible range 0.000–2.000. This is not seconds; 1.000 is the fallback read value. Actual effects remain experimental.";
"text.c7eefb673ecdb529" = "Animation time coefficient";
"text.c228e9329bf6ffea" = "Smaller values usually produce shorter animations, but a linear relationship with visible duration is not guaranteed.";
"text.740ca06592394acb" = "Scroll over icons to show app windows";
"text.f233952b66bcedc4" = "Scroll up over a Dock icon to show all windows of that app, or expand a stack with the same gesture. Scroll direction depends on System Settings.";
"text.e8ff44c802647f6c" = "The plain-text scroll-to-open key was not found in the main Dock binary on macOS 26.6.1. Its address, Boolean type, and delete-to-restore path remain clear, but it may have moved to a private component, be read only for compatibility, or be ignored. Even if read, the result depends on the scrolling device, system scroll direction, and icon type.";
"text.2cc6195f58ad115b" = "Disable pinch to show Applications";
"text.f15a72e7b03fadd8" = "On macOS Tahoe, disable the thumb-and-three-finger pinch that shows Applications. Does not disable spreading fingers to show the desktop. Applies only when system multi-finger pinch gestures are enabled.";
"text.41a8778b459771cb" = "Dock 26.6.1 reads showSpotlightGestureEnabled as a Boolean, defaulting to on. No physical-trackpad pinch regression was performed. The master gesture switch, hardware capability, or later system updates may leave the action unchanged despite a successful write.";
"text.b71cdac7e42c7526" = "Try disabling the legacy Launchpad pinch";
"text.26400796caf12baa" = "Sets the legacy showLaunchpadGestureEnabled gate to false. It is independent of the gate used for Tahoe's current Applications gesture.";
"text.70daf625ffc6bfff" = "Dock 26.6.1 still includes this key, Boolean property, and compatible Launchpad code, but Tahoe's current Applications action reads showSpotlightGestureEnabled. This legacy gate may affect only a compatibility branch or have no visible effect. Use the adjacent new gate to control the current action.";
"text.d8c58e42ed9f1c82" = "Disable app launch bounce animation";
"text.950759d51a3bdef0" = "Stops icon bouncing when opening apps from the Dock. Some modern apps may ignore this preference.";
"text.78416666a9a97eca" = "This key only controls launch bouncing managed by the Dock. Modern app launch presentation, restored windows, or custom icon animations may bypass it, so visible results can differ between apps.";
"text.d1a7a8a362215b8b" = "Show only running apps";
"text.526b2a686ab92023" = "Keep only currently running apps in the Dock. Pinned icons for apps that are not running are temporarily hidden.";
"text.aac6df28fffefe4c" = "Show the app switcher on all displays";
"text.879051a237495cec" = "Show the ⌘Tab app switcher on every display to make it easier to locate in a multi-display workspace.";
"text.8be38668fc31f06c" = "Dim hidden app icons";
"text.c0513edca105ad00" = "Make an app's Dock icon translucent after hiding the app with ⌘H.";
"text.65260246ae450f92" = "The plain-text showhidden key was not found in the main Dock binary on macOS 26.6.1. Its Boolean write and delete-to-restore paths remain clear, but the key may have moved to a private component, be read only for compatibility, or be ignored. If effective, it should only affect icons of apps hidden with ⌘H.";
"text.746a2671161aa94d" = "Enable single-app mode";
"text.96e7e83d729e642b" = "Automatically hide other apps when switching apps from the Dock to reduce desktop distractions.";
"text.4ac7c0b5105a83d" = "The plain-text single-app key was not found in the main Dock binary on macOS 26.6.1. Its Boolean write and delete-to-restore paths remain clear, but it may exist only in a compatibility branch or be ignored. If effective, switching apps from the Dock hides other apps and may interrupt a multi-window workflow.";
"text.4bbb606df711f00c" = "Dock alignment";
"text.87ed9c24a1cd4d16" = "Align the Dock at the start, center, or end of its screen edge. The direction depends on which edge contains the Dock.";
"text.b398531707374b13" = "Start";
"text.993da921e9c2f999" = "Center";
"text.db16cebffad5bde3" = "End";
"text.5f1864e739b32968" = "Hidden window minimization effect";
"text.e46aa38c80a72be2" = "Enable the Suck minimization animation, which System Settings does not list. You can separately use the Apple default or restore the original selection saved before this app took control.";
"text.7e3df281d8499d6a" = "Apple default (delete explicit value)";
"text.d59403a729edef27" = "Suck";
"text.c132c7332af099a3" = "“suck” is an undocumented historical animation value. Dock may fall back to another effect depending on the OS version, Reduce Motion, or implementation changes. Successful readback does not guarantee that the animation is used.";
"text.43b351139788846" = "Show the full path in window titles";
"text.5c8503f9c8a876dc" = "Show the current folder's POSIX path in the Finder title bar instead of only its name.";
"text.4298ad1a42a6c217" = "Finder restarts automatically";
"text.8ef1d2d8d23a537f" = "Show Quit Finder in the menu";
"text.5368929f51fa9904" = "Add a Quit item to the Finder menu. Desktop icons temporarily disappear when Finder quits.";
"text.22cc2a4e9d6b30d8" = "Reduce Finder animations";
"text.14b3e39c114909b" = "Disable some Finder animations, including opening windows and Get Info. Newer interfaces may respond only partially.";
"text.3957a64d17bedbfe" = "This master switch was still found in Finder on macOS 26.6.1. Windows, information panels, and modern SwiftUI interfaces may use different animation implementations, so only some animations may be reduced.";
"text.bd8174ddbcfa89bf" = "Try enabling Quick Look text selection";
"text.4887cbb016843e4a" = "Write the legacy Finder Boolean key QLEnableTextSelection to try selecting text in Quick Look previews opened with the Space bar.";
"text.5864fe0efb7a0c82" = "This key was not found in the local Finder or Quick Look 26.6.1 binaries. Modern previews may determine text selection by file type. This setting is therefore likely to be ignored or have no visible difference from built-in selection. Only Boolean writes and delete-to-restore behavior are guaranteed here.";
"text.ec61b6d361b17e63" = "Avoid .DS_Store files on network disks";
"text.513ab225b9fd353d" = "Reduce Finder metadata files in network locations such as SMB shares and NAS devices. Affects directories accessed afterward only.";
"text.3bd1ebe45d255d60" = "Log out and back in for the full effect";
"text.9e1ad115accc97cb" = "Avoid .DS_Store files on removable disks";
"text.d220f0528cfb12ae" = "Reduce Finder metadata files on USB drives and external disks. Existing files are not deleted.";
"text.19e35d7067d9e68a" = "Remove shadows from window screenshots";
"text.ab77922a7e37cc4e" = "Omit the transparent shadow border when capturing a window with ⌘⇧4 followed by Space.";
"text.7cce6ec3bb77f7cb" = "Applies to the next screenshot";
"text.706bb7baa9b55b4" = "Screenshot file format";
"text.ea13b16675daee78" = "Change the system screenshot format. JPEG is smaller but lossy; PNG works well for interfaces and text.";
"text.172bf101dfa62f2f" = "Exclude the date from filenames";
"text.a356667a135178eb" = "Create shorter screenshot filenames. The system still adds sequence numbers to avoid duplicate names.";
"text.4d135ef5b30a775e" = "Screenshot filename prefix";
"text.9361b3e1f4f60c64" = "Set the text at the start of the filename. Apply an empty value to restore the system default name.";
"text.3eeee482ffaea7ad" = "Try the legacy three-finger double-tap action";
"text.357b3bab5365a4e5" = "Write the historical value 2 to built-in and Bluetooth trackpad preference domains. Older systems retained a three-finger double-tap backend without documenting stable action semantics.";
"text.6962f4f86ed99981" = "Verify after logging in again, reconnecting the trackpad, or restarting";
"text.d606092384db7db4" = "Trackpad diagnostic resources on macOS 26.6.1 still expose a threeFingerDoubleTap semantic field. The mapping from the two current user preference domains to that field, and the action represented by integer 2, remain unverified. The write may have no effect, be overwritten by the system, or conflict with third-party gesture tools.";
"text.aec41ccdf38a4f33" = "Repeat letters when holding a key";
"text.8a8b5c3158fe0f11" = "Disable the accent-character popup so held letter keys repeat like arrow keys.";
"text.d38f5192e820bf89" = "Reopen affected apps for the change to take effect";
"text.8a0bb50052de03a7" = "Adjust key repeat speed";
"text.5f55a070d699c05" = "The common preset is faster than the System Settings slider (KeyRepeat 1, InitialKeyRepeat 10). You can also slow it down within the bounded range.";
"text.d4f6ca3a8c42dcab" = "Control the initial wait and ongoing repeat interval separately. Values use system ticks: smaller is faster. They are not converted to fixed milliseconds.";
"text.e47012affa6be15" = "Repeat interval";
"text.c085b057522d11af" = "Limited to 1–10 system ticks. Smaller values repeat a held key faster.";
"text.88d9c59685316424" = "ticks";
"text.c9a4492801e3cfcf" = "Delay until repeat";
"text.2c503591486c6ecf" = "Limited to 10–60 system ticks. Smaller values shorten the initial wait; very short waits may increase accidental input.";
"text.e19f347c6b011bd" = "Expand save dialogs by default";
"text.35fd1ca22cad03d6" = "Show the full file browser when saving a new file instead of a compact panel.";
"text.afc91ac07624802f" = "Expand print dialogs by default";
"text.312850ce7a5be16d" = "Show previews, paper settings, and detailed options immediately when printing.";
"text.1595aa1032d26de9" = "Prefer local storage for new documents";
"text.7eabb0fe09de45c8" = "Apps that honor this preference favor local storage instead of iCloud for the first save.";
"text.f121e1cd8df639d7" = "This is a global AppKit recommendation. Apps with independent document frameworks, their own sandboxed settings, or non-AppKit interfaces may ignore it, so first-save locations can differ between apps.";
"text.bec0aeea3181360f" = "Reduce window-opening animations";
"text.79ca09ae1a0bc60f" = "Disable window-opening animations in some apps. Not all modern apps honor this preference.";
"text.67b2285db9919622" = "This key affects only window paths that still read AppKit's global animation preference. SwiftUI, Catalyst, web containers, and custom-drawn windows may not respond; the effect varies by app.";
"text.9e0deb187c51c99b" = "Drag windows from anywhere with modifier keys";
"text.5e178d9f2d2857f0" = "Hold Control+Command to drag a window from its content area. Applies only to apps that follow this AppKit behavior.";
"text.36db0b05fe3b7cfe" = "Tooltip delay";
"text.71f78651d2a7ffc7" = "Shorten the wait before a hover tooltip appears. Affects only apps that read this AppKit preference.";
"text.96071d17d6c3b4fe" = "0.1 s";
"text.4ae8f8dd68218f5c" = "0.3 s";
"text.6ede1c55673ac5a" = "0.5 s";
"text.6afe32f87ad1a3ad" = "The integer millisecond value of NSInitialToolTipDelay can be written and read back. Modern apps may ignore it by using SwiftUI, custom tooltips, or their own timers. The displayed value is what is written, not a guaranteed delay in every app.";
"text.9e8d90ae6a9fb317" = "Fine-tune the hover wait within a range recognized by AppKit. Modern apps may ignore this preference.";
"text.1e934142da7e65dd" = "Tooltip delay";
"text.d93e6adc56e77e42" = "0 seconds shows tooltips immediately. The step is 0.001 seconds (1 millisecond), with a maximum of 2 seconds.";
"text.21b84cdfd2895c64" = "Disable automatic app termination";
"text.d887a6ee92009673" = "Prevent the system from silently terminating idle apps that support this mechanism. May increase memory use.";
"text.4939b73512e00caf" = "Set an exact screen saver idle time";
"text.b60edbe470feb4ed" = "Set an idle wait of 1–3600 seconds in 1-second steps, or select Never separately. Does not change lock-screen password requirements or display sleep time.";
"text.5ce520c1abac652e" = "Choosing a preset, timed mode, or Never only changes the draft. Apply explicitly to write the screen saver preference for this Mac.";
"text.60d91c304e4323d3" = "Idle wait time";
"text.e66e1a8377155078" = "Finite times range from 1–3600 seconds. Never writes integer 0. The app preset is 5 minutes, not the system default.";
"text.d6f78660ae542ad0" = "Never";
"text.a02e597d611ba237" = "1 min";
"text.3fab118479367cdb" = "5 min";
"text.c3d45e75dbde063f" = "10 min";
"text.5fa8bb4a2a4441e1" = "30 min";
"text.6f5cb516b4bb2fae" = "60 min";
"text.12877f636811c036" = "Read by subsequent system idle detection; actual timing awaits behavioral verification";
"text.55a78fe9b2f8366a" = "macOS 26.6.2 can read the current host's idleTime as integer seconds. No real screen saver timing test was performed, so visible effects of arbitrary seconds, System Settings feedback, and persistence remain unverified. 0 means the screen saver never starts; it does not change the lock-screen password policy.";
"text.cbcc2fd3cde149bb" = "Adjust menu bar item spacing";
"text.3adccf1237cf387f" = "The safe preset sets content padding and highlight expansion to 4 on this Mac. You can adjust density within the bounded range.";
"text.c54b4b03207ca889" = "Adjust content padding and selection-highlight expansion separately. Uses current-host scope and disallows negative values.";
"text.b952fe2933a64114" = "Item content padding";
"text.7a103eda997bf823" = "Added to each status item's content width. 0–1 points is very tight; larger values are more likely to put items behind the notch.";
"text.f4665ddd704d4e36" = "Highlight expansion";
"text.180f1baab519eea9" = "Controls how far the selected background extends on either side. Large values may bring adjacent highlights too close together.";
"text.acb5c0e2a939eea0" = "Do not suggest new disks for Time Machine";
"text.55a1ceb3c3a1c913" = "Stop suggesting a newly connected disk as a Time Machine backup destination.";
"text.1c49448d85407384" = "Applies the next time a new disk is connected";
"text.c7e5f3d44df9e09a" = "Enable extra WebKit developer features";
"text.f85c76ee70011b29" = "Enable developer menus such as Inspect Element in apps that honor global WebKit preferences. Does not replace Safari's own settings.";
"text.97a40d8bfbcba9db" = "This global key affects only hosts that still use the corresponding WebKit/AppKit preference bridge. Safari, WKWebView hosts, and apps with their own settings may ignore it independently. It does not guarantee that an Inspect Element menu appears.";
"text.13156f0593f45e9e" = "Prevent idle sleep during active terminal sessions";
"text.8e4dd9da0d53406" = "Prevent the Mac from automatically sleeping due to idleness while a local terminal or remote-login TTY session remains active. May increase power use.";
"text.caf16db274d3d3d" = "Applies immediately to this Mac's existing power sources";
"text.ee09916ab75863d1" = "Allow nearby trusted devices to wake this Mac";
"text.2144c8a619f4e7c2" = "Allow nearby devices using the same iCloud account to wake the system from sleep. Available only when supported by the hardware and power-management capabilities.";
